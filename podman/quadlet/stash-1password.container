# Stash with 1Password Secret Management
#
# This quadlet integrates 1Password for secure credential management
#
# Setup:
# 1. Install 1Password CLI: https://developer.1password.com/docs/cli/
# 2. Create vault "Stash Deployment" in 1Password
# 3. Add credential items to vault
# 4. Copy this file to ~/.config/containers/systemd/stash-1password.container
# 5. systemctl --user daemon-reload && systemctl --user start stash-1password.container
#
# For automated credential injection, create a wrapper script:
#
#   #!/bin/bash
#   eval $(op signin)
#   export STASH_DB_PASS=$(op read op://Stash\ Deployment/Database/password)
#   systemctl --user restart stash-1password.container

[Unit]
Description=Stash - 1Password Managed
Documentation=https://docs.stashapp.cc
After=network-online.target
Wants=network-online.target

[Container]
Image=stashapp/stash:latest
ContainerName=stash-1password
Restart=always
RestartPolicy=on-failure
RestartSec=10s

# Network configuration
PublishPort=9999:9999

# Environment variables
# Note: For 1Password integration, set these before starting the container:
#   eval $(op signin)
#   export STASH_DB_USER=$(op read op://Vault/Database/username)
#   export STASH_DB_PASSWORD=$(op read op://Vault/Database/password)
#   systemctl --user start stash-1password.container

Environment=STASH_STASH=/data/
Environment=STASH_GENERATED=/generated/
Environment=STASH_METADATA=/metadata/
Environment=STASH_CACHE=/cache/
Environment=STASH_PORT=9999
Environment=TZ=Etc/UTC

# Database credentials from 1Password (set via environment before starting)
Environment=STASH_DB_USER=%{STASH_DB_USER:-}
Environment=STASH_DB_PASSWORD=%{STASH_DB_PASSWORD:-}
Environment=STASH_DB_HOST=%{STASH_DB_HOST:-localhost}
Environment=STASH_DB_NAME=%{STASH_DB_NAME:-stash}

# API Keys from 1Password
Environment=STASH_SCRAPER_API_KEY=%{STASH_SCRAPER_API_KEY:-}

# Security
Environment=STASH_SESSION_SECRET=%{STASH_SESSION_SECRET:-}

# Volume mounts
Volume=%h/.stash/config:/root/.stash:rw
Volume=%h/.stash/data:/data:rw
Volume=%h/.stash/metadata:/metadata:rw
Volume=%h/.stash/cache:/cache:rw
Volume=%h/.stash/blobs:/blobs:rw
Volume=%h/.stash/generated:/generated:rw

# Logging configuration
LogDriver=journald

# Resource limits
Memory=2g
MemorySwap=4g
CPUQuota=80%

# Additional options
RunInit=yes
Pull=always

[Service]
Type=notify
Notify=conmon

# Optional: Restart script to refresh credentials periodically
# This can be used to rotate credentials without restarting manually
# ExecReload=bash -c 'eval $(op signin) && systemctl --user restart %n'

[Install]
WantedBy=default.target
