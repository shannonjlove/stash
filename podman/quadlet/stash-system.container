[Unit]
Description=Stash - Self-hosted media server (System-wide)
Documentation=https://docs.stashapp.cc
After=network-online.target
Wants=network-online.target

[Container]
Image=stashapp/stash:latest
ContainerName=stash
Restart=always
RestartPolicy=on-failure
RestartSec=10s

# Network configuration
PublishPort=9999:9999

# Environment variables
Environment=STASH_STASH=/var/lib/stash/data/
Environment=STASH_GENERATED=/var/lib/stash/generated/
Environment=STASH_METADATA=/var/lib/stash/metadata/
Environment=STASH_CACHE=/var/lib/stash/cache/
Environment=STASH_PORT=9999
Environment=TZ=Etc/UTC

# Run as stash user (create with: useradd -r -s /sbin/nologin stash)
User=stash

# Volume mounts (system paths)
Volume=/etc/stash:/root/.stash:rw
Volume=/var/lib/stash/data:/data:rw
Volume=/var/lib/stash/metadata:/metadata:rw
Volume=/var/lib/stash/cache:/cache:rw
Volume=/var/lib/stash/blobs:/blobs:rw
Volume=/var/lib/stash/generated:/generated:rw

# Logging configuration
LogDriver=journald

# Resource limits (adjust based on your system)
# Memory=2g
# MemorySwap=4g
# CPUQuota=80%

# Security options
SecurityLabelType=disable
NoNewPrivileges=no

# Additional options
RunInit=yes
Pull=always

[Service]
Type=notify
Notify=conmon
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
