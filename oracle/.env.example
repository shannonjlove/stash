# Jellyfin Configuration
JELLYFIN_LOG_LEVEL=info
JELLYFIN_CACHE_DIR=/cache

# Stash Configuration
STASH_DB_TYPE=sqlite
# STASH_DB_TYPE=postgres
# STASH_DB_HOST=postgres
# STASH_DB_NAME=stash
# STASH_DB_USER=stash
# STASH_DB_PASSWORD=changeme

# Optional: 1Password Integration
# STASH_SESSION_SECRET=your_secret_key

# Optional: PostgreSQL Configuration
# POSTGRES_DB=stash
# POSTGRES_USER=stash
# POSTGRES_PASSWORD=changeme

# System Configuration
TZ=Etc/UTC
PUID=1000
PGID=1000
