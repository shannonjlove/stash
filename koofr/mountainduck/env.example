# Copy to koofr/.env (gitignored). Never commit filled values.
# Koofr WebDAV for Mountain Duck (koofr2). Use a dedicated app password
# named mountainduck-koofr2 when possible — not the Hostinger/Oracle password.

KOOFR2_USER=shannonjlove@mac.com
KOOFR2_APP_PASSWORD=
KOOFR2_WEBDAV_URL=https://app.koofr.net/dav/Koofr

# IDrive e2 — region-specific keys. Leave blank until copied from 1Password / e2 console.
IDRIVE_E2_VA_ENDPOINT=p3h2.va.idrivee2-48.com
IDRIVE_E2_VA_ACCESS_KEY=
IDRIVE_E2_VA_SECRET_KEY=
IDRIVE_E2_VA_REGION=us-east-1

IDRIVE_E2_OR_ENDPOINT=d8v7.or4.idrivee2-73.com
IDRIVE_E2_OR_ACCESS_KEY=
IDRIVE_E2_OR_SECRET_KEY=
IDRIVE_E2_OR_REGION=us-west-1
