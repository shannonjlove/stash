# Koofr account (email used to sign in at https://app.koofr.net)
KOOFR_USER=you@example.com

# Application password from:
# https://app.koofr.net/app/admin/preferences/password
# Do NOT use your Koofr login password.
# Quote the value if it contains #, spaces, or shell metacharacters.
KOOFR_APP_PASSWORD='replace-with-koofr-app-password'

# rclone remote name and folder inside Koofr that holds the media library
KOOFR_REMOTE=koofr
KOOFR_PATH=Stash/media

# Stash
STASH_PORT=9999
TZ=Etc/UTC

# rclone VFS cache (local disk, not Koofr). Increase if the host has spare SSD space.
RCLONE_VFS_CACHE_MAX_SIZE=10G

# Host directory used by the sidecar mount fallback (ignored by the volume plugin)
KOOFR_MOUNT_POINT=/mnt/koofr
