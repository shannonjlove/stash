# Stash Docker Environment Configuration Example
# Copy this file to .env and customize as needed

# Port to expose Stash on (default: 9999)
STASH_PORT=9999

# Timezone for logging and scheduling
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Docker image version
# Options: latest, develop, or specific version (e.g., v0.28.0)
STASH_VERSION=latest

# Optional: Custom paths (uncomment and modify if needed)
# These should match the volume mounts in docker-compose.yml
# STASH_DATA_PATH=./data
# STASH_METADATA_PATH=./metadata
# STASH_GENERATED_PATH=./generated
# STASH_CACHE_PATH=./cache
# STASH_CONFIG_PATH=./config
# STASH_BLOBS_PATH=./blobs
